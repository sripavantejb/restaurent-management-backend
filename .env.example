# MongoDB Atlas (use database name restaurantos)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/restaurantos?retryWrites=true&w=majority

# Public backend URL (Vercel)
APP_URL=https://restaurent-management-backend-sage.vercel.app

# Comma-separated frontend origins allowed by CORS (use * for any)
CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

PORT=5000
